                "message": "Email Subject: {{1.subject}}\nEmail From: {{1.fromEmail}}\nEmail Body: {{ifempty(1.fullTextBody; 1.snippet)}}\n\nAnalyze this email and return ONLY this JSON (no markdown, start directly with {):\n{\"is_task\":true,\"urgency\":\"medium\",\"department_id\":\"exact-department-uuid\",\"required_skill\":\"skill description\",\"deadline\":null,\"summary\":\"one sentence summary\",\"assigned_to\":\"exact-member-uuid\",\"assignment_reason\":\"one sentence why this person\"}\n\nRules:\n- is_task: true only if email requires action from the team, false otherwise\n- urgency: low, medium, or high\n- department_id: copy exact department_id UUID from team list above\n- assigned_to: copy exact id UUID of the best matching team member\n- Pick the member whose skills best match the task\n- deadline: ISO 8601 string if mentioned, otherwise null\n- summary: max 2 sentences, no internal double quotes",
                "timeout": "",
                "threadId": "{{executionId}}",
                "outputType": "text",
                "modelConfig": {
                    "recursionLimit": 5,
                    "iterationsFromHistoryCount": "1"
                },
                "defaultModel": "claude-haiku-4-5",
                "systemPrompt": "You are an AI task delegation system. Analyze emails and assign tasks to team members. Return ONLY valid JSON, no markdown, no backticks, no explanation. Start with { and end with }.\n\nActive team members (use exact UUIDs):\n[{\"id\":\"3fddccfb-7f58-44c9-b7ef-824dd5973ff5\",\"name\":\"Mehmet Demir\",\"department_id\":\"3eb96565-2f10-4fa4-8ca4-b02f772b6b8a\",\"department\":\"customer-support\",\"skills\":[\"communication\",\"complaint management\"],\"workload\":2},{\"id\":\"9c134120-50b2-4fa7-b100-9e0da1700ca5\",\"name\":\"Zeynep Celik\",\"department_id\":\"3eb96565-2f10-4fa4-8ca4-b02f772b6b8a\",\"department\":\"customer-support\",\"skills\":[\"technical support\",\"onboarding\"],\"workload\":2},{\"id\":\"b5e07724-ca02-4bb9-95bd-9f38bae4ea96\",\"name\":\"Ali Yilmaz\",\"department_id\":\"a8b5ddfd-dfe0-4cc5-80ee-4c0829b3dad3\",\"department\":\"software\",\"skills\":[\"Python\",\"FastAPI\",\"backend\"],\"workload\":2},{\"id\":\"7b69e8d6-3f1a-41ea-a282-550d689ccc18\",\"name\":\"Ayse Kaya\",\"department_id\":\"a8b5ddfd-dfe0-4cc5-80ee-4c0829b3dad3\",\"department\":\"software\",\"skills\":[\"React\",\"TypeScript\",\"frontend\"],\"workload\":2},{\"id\":\"7efae355-93ac-435c-b9c3-071fbd0b0b09\",\"name\":\"Can Ozturk\",\"department_id\":\"c8980053-1bad-40c1-9d92-97eb56cb684e\",\"department\":\"finance\",\"skills\":[\"invoicing\",\"accounting\"],\"workload\":2},{\"id\":\"7940af90-e115-4ba4-abe8-9d55a8074e72\",\"name\":\"Selin Arslan\",\"department_id\":\"c8980053-1bad-40c1-9d92-97eb56cb684e\",\"department\":\"finance\",\"skills\":[\"contracts\",\"legal\"],\"workload\":2}]"
            },
            "metadata": {
